# ─────────────────────────────────────────────────────────────────────────────
# fugu-swarm — drop your API keys here, then `cp .env.example .env`.
# This is the ONE file you edit to add/remove worker providers.
# `.env` is git-ignored; `.env.example` is the tracked template.
# ─────────────────────────────────────────────────────────────────────────────

# --- Worker pool: the models the coordinator routes among --------------------
# litellm-style "provider/model" names, comma-separated, NO spaces.
# The coordinator picks per query and per role (Thinker / Worker / Verifier).
# Diversity helps — give it different model families so the Verifier isn't the
# same brain as the Worker. See MODELS.md for the full "what to run" guide.
#
# RECOMMENDED best-of-breed mix (paid, real Fugu-quality). Needs the keys below.
# Claude for judgement/verify, DeepSeek-V4 for cheap heavy reasoning + coding,
# GPT + Gemini for diversity. Edit names to taste / current releases.
SLOT_MODELS=anthropic/claude-opus-4-8,deepseek/deepseek-reasoner,deepseek/deepseek-chat,openai/gpt-5.5,gemini/gemini-3.1-pro
#
# Zero-cost local preset (Termux/laptop, small-model quality) — swap in by
# uncommenting this and commenting the line above:
# SLOT_MODELS=ollama/qwen3:8b,ollama/deepseek-r1:7b
#
# Self-hosted "best local" preset (needs a real GPU box, see MODELS.md):
# SLOT_MODELS=ollama/qwen3.6:27b,ollama/gemma4:27b,ollama/deepseek-v4-flash

# --- Provider API keys (fill the ones you reference in SLOT_MODELS) -----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NOVITA_API_KEY=
# Add others as needed: GROQ_API_KEY, TOGETHER_API_KEY, OPENROUTER_API_KEY, ...

# --- Web search tool (lets workers/verifier ground answers on live data) ------
# Set one. The swarm exposes a `web_search` tool to any role when a key is present.
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_API_KEY=

# --- Local Ollama (only if you use ollama/* models above) --------------------
OLLAMA_API_BASE=http://localhost:11434

# --- OpenFugu's own backbone/eval endpoint (optional) ------------------------
# Used by some OpenFugu eval/serve paths for the worker-call backend. Leave the
# base URL pointing at this server's own OpenAI-compatible endpoint unless you
# know you need something else.
FUGU_API_KEY=
FUGU_BASE_URL=http://localhost:8088/v1

# --- Server ------------------------------------------------------------------
PORT=8088
SERVED_MODEL_NAME=fugu
