# ─────────────────────────────────────────────────────────────────────────────
# fugu-swarm — ALL-CLOUD (non-local) config. Paste your keys, then run ./serve.sh
# This is the ONE file you edit. `.env` is git-ignored; `.env.example` is tracked.
# No Ollama / no local weights — every worker is a hosted API.
# ─────────────────────────────────────────────────────────────────────────────

# --- Worker pool (all hosted APIs) -------------------------------------------
# litellm-style "provider/model" names, comma-separated, NO spaces.
# All the strong models BAR GPT, plus out-of-the-way open ones (Nemotron 3,
# Kimi K2.6, GLM-5.1) reached via OpenRouter / NVIDIA NIM. See BENCHMARKS.md.
#   Claude  -> judgement / verify         DeepSeek-V4 -> cheap heavy reasoning+coding
#   Gemini  -> long-context generalist    Kimi/GLM/Nemotron -> open-weight diversity
SLOT_MODELS=anthropic/claude-opus-4-8,gemini/gemini-3.1-pro,deepseek/deepseek-reasoner,deepseek/deepseek-chat,openrouter/moonshotai/kimi-k2.6,openrouter/z-ai/glm-5.1,nvidia_nim/nvidia/nemotron-3-ultra
#
# (GPT-5.5 excluded by choice. To add it back: append openai/gpt-5.5 + set OPENAI_API_KEY.)
#
# Want even more diversity? these all run through the OPENROUTER_API_KEY below:
#   openrouter/minimax/minimax-m2.5, openrouter/qwen/qwen3.6-235b, openrouter/deepseek/deepseek-v4-pro

# --- Provider API keys (fill the ones referenced in SLOT_MODELS) --------------
ANTHROPIC_API_KEY=          # Claude            -> https://console.anthropic.com
GEMINI_API_KEY=             # Gemini            -> https://aistudio.google.com
DEEPSEEK_API_KEY=           # DeepSeek V4       -> https://platform.deepseek.com
OPENROUTER_API_KEY=         # Kimi/GLM/MiniMax/Qwen (one key, many models) -> https://openrouter.ai/keys
NVIDIA_NIM_API_KEY=         # Nemotron 3        -> https://build.nvidia.com
# OPENAI_API_KEY=           # GPT excluded by choice; uncomment + set to re-add gpt
# MOONSHOT_API_KEY=         # only if you call Kimi direct instead of via OpenRouter
# ZHIPU_API_KEY=            # only if you call GLM direct instead of via OpenRouter

# --- Web search tool (lets workers/verifier ground answers on live data) ------
# Set one. The swarm exposes a `web_search` tool to any role when a key is present.
TAVILY_API_KEY=             # -> https://tavily.com
SERPAPI_API_KEY=
BRAVE_API_KEY=

# --- OpenFugu's own backbone/eval endpoint (optional) ------------------------
# The tiny router still runs locally (Qwen3-0.6B, negligible). This points the
# worker-call backend at this server's own OpenAI-compatible endpoint.
FUGU_API_KEY=
FUGU_BASE_URL=http://localhost:8088/v1

# --- Server ------------------------------------------------------------------
PORT=8088
SERVED_MODEL_NAME=fugu
