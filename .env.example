# ─────────────────────────────────────────────────────────────────────────────
# fugu-swarm — drop your API keys here, then `cp .env.example .env`.
# This is the ONE file you edit to add/remove worker providers.
# `.env` is git-ignored; `.env.example` is the tracked template.
# ─────────────────────────────────────────────────────────────────────────────

# --- Worker pool: the models the coordinator routes among --------------------
# litellm-style "provider/model" names, comma-separated, NO spaces.
# The coordinator picks per query and per role (Thinker / Worker / Verifier).
# Diversity helps — give it different model families so the Verifier isn't the
# same brain as the Worker. See MODELS.md for the full "what to run" guide.
#
# RECOMMENDED pool: all the strong models BAR GPT, plus out-of-the-way picks
# (Nemotron 3, Kimi K2.6, GLM-5.1) for diversity beyond the Claude/Gemini/DeepSeek
# mainstream. See BENCHMARKS.md for the numbers behind each. Needs keys below.
#   Claude  -> judgement / verify        DeepSeek-V4 -> cheap heavy reasoning+coding
#   Gemini  -> long-context generalist   Kimi/GLM/Nemotron -> open-weight diversity
SLOT_MODELS=anthropic/claude-opus-4-8,gemini/gemini-3.1-pro,deepseek/deepseek-reasoner,deepseek/deepseek-chat,openrouter/moonshotai/kimi-k2.6,openrouter/z-ai/glm-5.1,nvidia_nim/nvidia/nemotron-3-ultra
#
# (GPT-5.5 deliberately excluded. To add it back: append openai/gpt-5.5 and set OPENAI_API_KEY.)
#
# Zero-cost local preset (Termux/laptop, small-model quality):
# SLOT_MODELS=ollama/qwen3:8b,ollama/deepseek-r1:7b
#
# Self-hosted "best local" preset (real GPU box, see MODELS.md):
# SLOT_MODELS=ollama/qwen3.6:27b,ollama/nemotron3:super,ollama/deepseek-v4-flash

# --- Provider API keys (fill the ones you reference in SLOT_MODELS) -----------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# OpenRouter = one key for the out-of-the-way models (Kimi K2.6, GLM-5.1, MiniMax…)
OPENROUTER_API_KEY=
# NVIDIA NIM = Nemotron 3 (Ultra/Super/Nano)
NVIDIA_NIM_API_KEY=
# OPENAI_API_KEY=   # GPT excluded by choice; uncomment + set if you add gpt back
NOVITA_API_KEY=
# Add others as needed: GROQ_API_KEY, TOGETHER_API_KEY, MOONSHOT_API_KEY, ...

# --- Web search tool (lets workers/verifier ground answers on live data) ------
# Set one. The swarm exposes a `web_search` tool to any role when a key is present.
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_API_KEY=

# --- Local Ollama (only if you use ollama/* models above) --------------------
OLLAMA_API_BASE=http://localhost:11434

# --- OpenFugu's own backbone/eval endpoint (optional) ------------------------
# Used by some OpenFugu eval/serve paths for the worker-call backend. Leave the
# base URL pointing at this server's own OpenAI-compatible endpoint unless you
# know you need something else.
FUGU_API_KEY=
FUGU_BASE_URL=http://localhost:8088/v1

# --- Server ------------------------------------------------------------------
PORT=8088
SERVED_MODEL_NAME=fugu
